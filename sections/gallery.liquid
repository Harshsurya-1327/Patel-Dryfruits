{{ 'gallery.css' | asset_url | stylesheet_tag }}

{% liquid
  assign animation_effect = settings.animations
  assign animated = false

  if animation_effect != 'none'
    assign animated = true

    if section.settings.animations != 'inherit'
      assign animation_effect = section.settings.animations
    endif
  endif

  assign layout = section.settings.layout
  assign enable_swipe_mobile = section.settings.use_scroll_mobile

  assign total_items = section.blocks.size
  assign columns = section.settings.grid_columns

  if section.settings.layout == 'metro'
    if columns >= 8
      assign columns = 8
    else
      assign columns = 6
    endif
  endif

  if section.settings.layout == 'metro-left'
    assign columns = 5
  endif

  assign columns_tablet = columns

  if columns > 4
    assign columns_tablet = 4
  endif

  assign dividend = columns

  unless layout == 'grid'
    assign dividend = columns | minus: 2
  endunless

  if dividend > 0
    assign row = total_items | plus: 0.0 | divided_by: dividend | ceil
  else
    assign row = 1
  endif

  assign is_gifting_instagram = false

  if section.settings.custom_class contains 'm-gifting-instagram'
    assign is_gifting_instagram = true
  endif
%}

{%- style -%}

  #m-section-{{ section.id }} {
    --section-padding-top: {{ section.settings.padding_top }}px;
    --section-padding-bottom: {{ section.settings.padding_bottom }}px;
    --column-gap: {{ section.settings.column_gap }}px;
    --row-gap: {{ section.settings.row_gap }}px;
    --column-gap-mobile: {{ section.settings.mobile_gap }}px;
  }

  /* =========================================================
     PATEL DRY FRUITS - INSTAGRAM MARQUEE
     Only active when custom class is:
     m-gifting-instagram
     ========================================================= */

  #m-section-{{ section.id }}.m-gifting-instagram {
    padding-top: 0;
    padding-bottom: 0;
    overflow: hidden;
  }

  #m-section-{{ section.id }}.m-gifting-instagram .m-section-my,
  #m-section-{{ section.id }}.m-gifting-instagram .m-section-py {
    margin-top: 0;
    margin-bottom: 0;
    padding-top: 0;
    padding-bottom: 0;
  }

  #m-section-{{ section.id }}.m-gifting-instagram .m-section__header {
    padding-top: {{ section.settings.padding_top }}px;
    padding-bottom: 18px;
    margin: 0;
  }

  #m-section-{{ section.id }}.m-gifting-instagram .m-section__heading {
    margin-bottom: 4px;
  }

  #m-section-{{ section.id }}.m-gifting-instagram .m-section__subheading {
    margin: 0;
    line-height: 1.2;
  }

  /* =========================================================
     MARQUEE WINDOW
     ========================================================= */

  #m-section-{{ section.id }}.m-gifting-instagram .m-instagram-marquee {
    width: 100%;
    overflow: hidden;
    position: relative;
  }

  /* =========================================================
     MARQUEE TRACK

     There are TWO identical groups.

     Group 1:
     [1][2][3][4][5][6][7][8]  gap  Group 2

     Because both groups are identical, -50% remains seamless.
     ========================================================= */

  #m-section-{{ section.id }}.m-gifting-instagram .m-instagram-marquee__track {
    display: flex;
    width: max-content;
    align-items: stretch;
    will-change: transform;
    animation: m-instagram-marquee-{{ section.id }} 28s linear infinite;
  }

  /* =========================================================
     EACH IMAGE GROUP
     
     gap = space between images
     padding-right = space between the END of group 1
                    and START of group 2
     ========================================================= */

  #m-section-{{ section.id }}.m-gifting-instagram .m-instagram-marquee__group {
    display: flex;
    flex-shrink: 0;
    align-items: stretch;
    gap: 8px;
    padding-right: 8px;
    box-sizing: border-box;
  }

  /* =========================================================
     DESKTOP IMAGE SIZE

     Approximately 8–9 images are visible across the screen.
     The width is calculated from the viewport rather than
     using a fixed 140px size.
     ========================================================= */

  #m-section-{{ section.id }}.m-gifting-instagram .m-instagram-marquee__item {
    display: block;
    flex: 0 0 calc((100vw - 68px) / 8.5);
    width: calc((100vw - 68px) / 8.5);
    height: calc((100vw - 68px) / 8.5);
    max-width: 180px;
    max-height: 180px;
    overflow: hidden;
    border-radius: 12px;
    position: relative;
    text-decoration: none;
    background: #f4f0ea;
  }

  /* =========================================================
     IMAGE MEDIA
     ========================================================= */

  #m-section-{{ section.id }}.m-gifting-instagram .m-instagram-marquee__media {
    width: 100%;
    height: 100%;
    overflow: hidden;
  }

  #m-section-{{ section.id }}.m-gifting-instagram .m-instagram-marquee__media img,
  #m-section-{{ section.id }}.m-gifting-instagram .m-instagram-marquee__media svg {
    width: 100%;
    height: 100%;
    display: block;
    object-fit: cover;
  }

  /* =========================================================
     HOVER
     ========================================================= */

  #m-section-{{ section.id }}.m-gifting-instagram .m-instagram-marquee__item:hover img {
    transform: scale(1.04);
  }

  #m-section-{{ section.id }}.m-gifting-instagram .m-instagram-marquee__media img {
    transition: transform 0.35s ease;
  }

  /* =========================================================
     INFINITE ANIMATION

     Two identical groups = move exactly 50%.
     ========================================================= */

  @keyframes m-instagram-marquee-{{ section.id }} {
    from {
      transform: translate3d(0, 0, 0);
    }

    to {
      transform: translate3d(-50%, 0, 0);
    }
  }

  /* =========================================================
     DESKTOP
     ========================================================= */

  @media screen and (min-width: 750px) {

    #m-section-{{ section.id }}.m-gifting-instagram .m-section__header {
      padding-bottom: 20px;
    }

    #m-section-{{ section.id }}.m-gifting-instagram .m-instagram-marquee__group {
      gap: 8px;
      padding-right: 8px;
    }

    #m-section-{{ section.id }}.m-gifting-instagram .m-instagram-marquee__item {
      flex-basis: calc((100vw - 68px) / 8.5);
      width: calc((100vw - 68px) / 8.5);
      height: calc((100vw - 68px) / 8.5);
      border-radius: 12px;
    }
  }

  /* =========================================================
     MOBILE
     ========================================================= */

  @media screen and (max-width: 749px) {

    #m-section-{{ section.id }}.m-gifting-instagram .m-section__header {
      padding-top: {{ section.settings.padding_top }}px;
      padding-bottom: 14px;
    }

    #m-section-{{ section.id }}.m-gifting-instagram .m-section__heading {
      margin-bottom: 3px;
    }

    #m-section-{{ section.id }}.m-gifting-instagram .m-instagram-marquee__group {
      gap: 5px;
      padding-right: 5px;
    }

    #m-section-{{ section.id }}.m-gifting-instagram .m-instagram-marquee__item {
      flex-basis: 105px;
      width: 105px;
      height: 105px;
      border-radius: 10px;
    }
  }

  /* =========================================================
     REDUCED MOTION
     ========================================================= */

  @media (prefers-reduced-motion: reduce) {

    #m-section-{{ section.id }}.m-gifting-instagram .m-instagram-marquee__track {
      animation-play-state: paused;
    }
  }

{%- endstyle -%}


<section
  id="m-section-{{ section.id }}"
  class="m-section m-gallery-section m-gallery-section--{{ layout }} m-gradient m-color-{{ section.settings.color_scheme }} {{ section.settings.custom_class }}"
>

  {% if is_gifting_instagram %}

    {%- comment -%}
      =======================================================
      PATEL DRY FRUITS - FOLLOW OUR INSTAGRAM
      Continuous infinite marquee
      =======================================================
    {%- endcomment -%}

    <div class="m-instagram-marquee-section">

      {% if section.settings.heading != blank or section.settings.subheading != blank %}

        <div class="m-section__header m:text-{{ section.settings.header_alignment }}">

          {% if section.settings.subheading != blank %}

            <p class="m-section__subheading">
              {{ section.settings.subheading }}
            </p>

          {% endif %}

          {% if section.settings.heading != blank %}

            <h2 class="m-section__heading {{ section.settings.heading_size | default: 'h3' }}">
              {{ section.settings.heading }}
            </h2>

          {% endif %}

        </div>

      {% endif %}


      <div class="m-instagram-marquee">

        <div class="m-instagram-marquee__track">

          {%- comment -%}
            ===================================================
            FIRST IMAGE GROUP
            ===================================================
          {%- endcomment -%}

          <div class="m-instagram-marquee__group">

            {% for block in section.blocks %}

              {% if block.settings.link != blank %}

                <a
                  href="{{ block.settings.link }}"
                  class="m-instagram-marquee__item"
                  target="_blank"
                  rel="noopener noreferrer"
                  {{ block.shopify_attributes }}
                >

              {% else %}

                <div
                  class="m-instagram-marquee__item"
                  {{ block.shopify_attributes }}
                >

              {% endif %}

                  <div class="m-instagram-marquee__media">

                    {% if block.settings.image != blank %}

                      {% render 'responsive-image',
                        image: block.settings.image,
                        wrapper_class: 'm:w-full m:h-full',
                        aspect_ratio: 1
                      %}

                    {% else %}

                      {{ 'image' | placeholder_svg_tag: 'm-placeholder-svg m:w-full m:h-full m:object-cover' }}

                    {% endif %}

                  </div>

              {% if block.settings.link != blank %}

                </a>

              {% else %}

                </div>

              {% endif %}

            {% endfor %}

          </div>


          {%- comment -%}
            ===================================================
            SECOND IDENTICAL GROUP

            aria-hidden prevents duplicate images from being
            read twice by screen readers.
            ===================================================
          {%- endcomment -%}

          <div
            class="m-instagram-marquee__group"
            aria-hidden="true"
          >

            {% for block in section.blocks %}

              {% if block.settings.link != blank %}

                <a
                  href="{{ block.settings.link }}"
                  class="m-instagram-marquee__item"
                  tabindex="-1"
                  aria-hidden="true"
                >

              {% else %}

                <div
                  class="m-instagram-marquee__item"
                  aria-hidden="true"
                >

              {% endif %}

                  <div class="m-instagram-marquee__media">

                    {% if block.settings.image != blank %}

                      {% render 'responsive-image',
                        image: block.settings.image,
                        wrapper_class: 'm:w-full m:h-full',
                        aspect_ratio: 1
                      %}

                    {% else %}

                      {{ 'image' | placeholder_svg_tag: 'm-placeholder-svg m:w-full m:h-full m:object-cover' }}

                    {% endif %}

                  </div>

              {% if block.settings.link != blank %}

                </a>

              {% else %}

                </div>

              {% endif %}

            {% endfor %}

          </div>

        </div>

      </div>

    </div>


  {% else %}

    {%- comment -%}
      =======================================================
      ORIGINAL GALLERY BEHAVIOUR

      Used by every other gallery section.
      =======================================================
    {%- endcomment -%}

    <div class="{{ section.settings.container }} m-section-my m-section-py">

      {% if section.settings.heading != blank
        or section.settings.description != blank
        or section.settings.subheading != blank
        or section.settings.button_label != blank
      %}

        <div class="m-section__header m:text-{{ section.settings.header_alignment }}{% unless layout == 'grid' %} lg:m:hidden{% endunless %}">

          {% if section.settings.subheading != blank %}

            <p class="m-section__subheading{% if animated %} m-scroll-trigger animate--{{ animation_effect }}{% endif %}">
              {{ section.settings.subheading }}
            </p>

          {% endif %}

          {% if section.settings.heading != blank %}

            <h2 class="m-section__heading {{ section.settings.heading_size | default: 'h3' }}{% if animated %} m-scroll-trigger animate--{{ animation_effect }}{% endif %}">
              {{ section.settings.heading }}
            </h2>

          {% endif %}

          {% if section.settings.description != blank %}

            <div class="m-section__description{% if animated %} m-scroll-trigger animate--{{ animation_effect }}{% endif %}">
              {{ section.settings.description }}
            </div>

          {% endif %}

          {% if section.settings.button_label != blank %}

            <div class="m-section__button{% if animated %} m-scroll-trigger animate--{{ animation_effect }}{% endif %}">

              <a
                class="m-button {{ section.settings.button_style }}"
                {% if section.settings.button_link != blank %}
                  href="{{ section.settings.button_link }}"
                {% else %}
                  aria-disabled="true"
                {% endif %}
              >
                {{ section.settings.button_label }}
              </a>

            </div>

          {% endif %}

        </div>

      {% endif %}


      <div class="m-gallery m-gallery--{{ columns }}-columns m-gallery--{{ row }}-rows{% if enable_swipe_mobile %} swipe-mobile swipe-mobile--{{ section.settings.columns_mobile }}-cols{% endif %}">

        <div class="m-gallery__wrapper m:display-grid m:grid-{{ section.settings.columns_mobile }}-cols md:m:grid-{{ columns_tablet }}-cols lg:m:grid-{{ columns }}-cols{% if enable_swipe_mobile %} swipe-mobile__inner{% endif %}">

          {% unless layout == 'grid' %}

            <div class="m-gallery__item m-gallery__info m:text-center m:hidden lg:m:flex m:blocks-radius m-gradient m-color-{{ section.settings.color_scheme_content }}">

              {% if section.settings.subheading != blank %}

                <p class="m-section__subheading">
                  {{ section.settings.subheading }}
                </p>

              {% endif %}

              {% if section.settings.heading != blank %}

                <h2 class="m-section__heading {{ section.settings.heading_size | default: 'h3' }}">
                  {{ section.settings.heading }}
                </h2>

              {% endif %}

              {% if section.settings.description != blank %}

                <div class="m-section__description">
                  {{ section.settings.description }}
                </div>

              {% endif %}

              {% if section.settings.button_label != blank %}

                <div class="m-section__button">

                  <a
                    class="m-button {{ section.settings.button_style }}"
                    {% if section.settings.button_link != blank %}
                      href="{{ section.settings.button_link }}"
                    {% else %}
                      aria-disabled="true"
                    {% endif %}
                  >
                    {{ section.settings.button_label }}
                  </a>

                </div>

              {% endif %}

            </div>

          {% endunless %}


          {% for block in section.blocks %}

            <{% if block.settings.link != blank %}a href="{{ block.settings.link }}"{% else %}div{% endif %}
              class="m-gallery__item m:relative m:block m:blocks-radius{% if animated %} m-scroll-trigger animate--{{ animation_effect }}{% endif %}"
              {% if animated %}
                data-cascade
                style="--animation-order: {{ forloop.index }};"
              {% endif %}
              {% if block.settings.link != blank %}
                target="_blank"
                rel="noopener noreferrer"
              {% endif %}
            >

              <div class="m-gallery__media">

                {% if block.settings.image != blank %}

                  {% render 'responsive-image',
                    image: block.settings.image,
                    wrapper_class: 'm:w-full m:h-full',
                    aspect_ratio: 1
                  %}

                {% else %}

                  {{ 'image' | placeholder_svg_tag: 'm-placeholder-svg m:w-full m:h-full m:object-cover' }}

                {% endif %}

              </div>

              {% if section.settings.icon != 'none' and block.settings.link != blank %}

                <div class="m-gallery__content">

                  <div class="m-gallery__icon">

                    {% render 'icon',
                      name: section.settings.icon,
                      size: 'large'
                    %}

                  </div>

                </div>

              {% endif %}

            </{% if block.settings.link != blank %}a{% else %}div{% endif %}>

          {% endfor %}

        </div>

      </div>

    </div>

  {% endif %}

</section>


